{
  "name": "moticon-site",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://moticon-web.vercel.app",
  "scripts": {
    "generate": "node scripts/build-icon-details.mjs && node scripts/build-icon-metadata.mjs && npm run build:registry",
    "build:registry": "node scripts/build-registry.mjs && shadcn build registry.json --output public/r",
    "predev": "npm run generate",
    "dev": "next dev",
    "prebuild": "npm run build --workspace=@moticon/react && npm run generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@moticon/react": "*",
    "@vercel/analytics": "^2.0.1",
    "cmdk": "^1.1.1",
    "motion": "11.18.2",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "shadcn": "4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
