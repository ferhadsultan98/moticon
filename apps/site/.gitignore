# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# generated at build time from packages/moticon/src/icons/*.json
/src/generated/

# shadcn registry — regenerated from packages/moticon/src/enhanced/*.tsx by
# `npm run build:registry` (runs in prebuild); the served JSON is a build artifact
/registry/
/registry.json
/public/r/

# typescript
*.tsbuildinfo
next-env.d.ts
