{
  "name": "@moticon/react",
  "version": "0.1.2",
  "description": "Animated React icons with object-specific motion mechanics — each icon's animation models how the real object moves (a bell rings, a heart beats, a download drops), not a generic scale/rotate tween. Typed, tree-shakeable, Next.js App Router compatible, respects prefers-reduced-motion. Built on Motion (Framer Motion).",
  "author": {
    "name": "Farhad Sultanov",
    "url": "https://www.linkedin.com/in/farhadsultan/"
  },
  "license": "MIT",
  "homepage": "https://moticon-web.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferhadsultan98/moticon.git",
    "directory": "packages/moticon"
  },
  "bugs": {
    "url": "https://github.com/ferhadsultan98/moticon/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "require": "./dist/registry.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/icons/*.json",
    "src/icons/*.tsx",
    "icon.schema.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:gpt-playground": "node scripts/build-gpt-playground-icons.mjs",
    "generate:exports": "node scripts/generate-exports.mjs",
    "fix:use-client": "node scripts/inject-use-client.mjs",
    "build:registry": "node scripts/build-registry.mjs",
    "prebuild": "npm run build:gpt-playground && npm run generate:exports && npm run build:registry",
    "build": "node scripts/build.mjs",
    "predev": "npm run build:gpt-playground && npm run generate:exports && npm run build:registry",
    "dev": "npm run build",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "prepublishOnly": "npm run typecheck && npm run build && npm run size"
  },
  "keywords": [
    "icons",
    "react",
    "react-icons",
    "icon-library",
    "animated-icons",
    "animated-svg-icons",
    "animated-react-icons",
    "motion-icons",
    "micro-interactions",
    "ui-animation",
    "animation",
    "motion",
    "framer-motion",
    "svg",
    "svg-icons",
    "lucide",
    "tree-shakeable",
    "typescript",
    "nextjs"
  ],
  "peerDependencies": {
    "motion": ">=11 <14",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^19.2.7",
    "lucide-static": "^1.33.0",
    "motion": "^11.11.0",
    "react": "^18.3.0",
    "react-dom": "^19.2.8",
    "size-limit": "^13.0.3",
    "typescript": "^5.6.0"
  },
  "size-limit": [
    {
      "name": "full bundle (all 343 icons)",
      "path": "dist/index.js",
      "limit": "600 kB",
      "ignore": [
        "react",
        "react-dom",
        "motion"
      ]
    },
    {
      "name": "single icon (tree-shaken)",
      "path": "dist/index.js",
      "import": "{ Bell }",
      "limit": "10 kB",
      "ignore": [
        "react",
        "react-dom",
        "motion"
      ]
    },
    {
      "name": "registry only",
      "path": "dist/registry.js",
      "limit": "150 kB"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
