{
  "name": "@moticon/react",
  "version": "0.1.0",
  "description": "328 animated React icons, each modeling a real physical mechanic instead of a generic scale/opacity tween. Built on motion/react.",
  "author": "Farhad Sultanov",
  "license": "MIT",
  "homepage": "https://github.com/ferhadsultan98/moticon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferhadsultan98/moticon.git"
  },
  "bugs": {
    "url": "https://github.com/ferhadsultan98/moticon/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "require": "./dist/registry.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/icons/*.json",
    "src/icons/*.tsx",
    "icon.schema.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate:exports": "node scripts/generate-exports.mjs",
    "fix:use-client": "node scripts/inject-use-client.mjs",
    "build:registry": "node scripts/build-registry.mjs",
    "prebuild": "npm run generate:exports && npm run build:registry",
    "build": "tsup",
    "predev": "npm run generate:exports && npm run build:registry",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "prepublishOnly": "npm run typecheck && npm run build && npm run size"
  },
  "keywords": [
    "icons",
    "icon-library",
    "react",
    "react-icons",
    "animated-icons",
    "animation",
    "motion",
    "framer-motion",
    "motion-react",
    "svg",
    "svg-icons",
    "lucide",
    "lucide-icons",
    "typescript"
  ],
  "peerDependencies": {
    "motion": ">=11",
    "react": ">=18"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.33.0",
    "motion": "^11.11.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.1",
    "size-limit": "^13.0.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "size-limit": [
    {
      "name": "full bundle (all 328 icons)",
      "path": "dist/index.js",
      "limit": "600 kB",
      "ignore": ["react", "react-dom", "motion"]
    },
    {
      "name": "single icon (tree-shaken)",
      "path": "dist/index.js",
      "import": "{ Bell }",
      "limit": "10 kB",
      "ignore": ["react", "react-dom", "motion"]
    },
    {
      "name": "registry only",
      "path": "dist/registry.js",
      "limit": "150 kB"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
